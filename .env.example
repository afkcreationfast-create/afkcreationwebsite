# Render: create a PostgreSQL database and copy its Internal Database URL here.
DATABASE_URL=postgresql://user:password@host:5432/database
SESSION_SECRET=replace-with-a-long-random-secret
# Set to true on Render when using its HTTPS proxy.
COOKIE_SECURE=true
# Main public domain
ROOT_DOMAIN=afkcreation.site
# Optional: set to true only for local development
TRUST_PROXY=false
PORT=3000
